# Public API URL, also used by the admin server's proxy routes.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Required during builds and at runtime. Set a unique random secret (32+ chars).
SESSION_SECRET=

# Configure the existing admin and uploader authentication credentials.
ADMIN_PASSWORD_HASH=
UPLOADER_PASSWORD_HASH=

# Server-side API access.
ADMIN_API_KEY=
MARKETPLACE_API_KEY=

# Existing Pinata configuration used by the admin app.
NEXT_PUBLIC_PINATA_JWT=
NEXT_PUBLIC_PINATA_GATEWAY=
